{
  "name": "volstrat-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloudflare Worker that triggers the VolStrat data-update GitHub Action on a reliable schedule.",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail volstrat-cron",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.149.0"
  }
}
