// Triggers the VolStrat data pipeline (a GitHub Actions workflow) on a schedule
// that, unlike GitHub's own `schedule:` trigger, fires on time.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volstrat-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // UTC. 23:20 = 19:20 EDT / 18:20 EST (after the pipeline's 18:00 New York
  // end-of-day cutoff); 01:20 and 03:20 catch late publishers (Cboe VIX row,
  // CFE settlements, Yahoo ETF bars); 11:20 is the morning catch-up. Runs on
  // weekends too: a run with nothing new is a no-op, and it keeps this to one
  // cron trigger.
  "triggers": { "crons": ["20 1,3,11,23 * * *"] },
  "vars": {
    "GITHUB_REPO": "kevincgith/volstrat",
    "WORKFLOW": "data-update.yml",
    "REF": "main"
  },
  // GITHUB_TOKEN is a secret: `npx wrangler secret put GITHUB_TOKEN` (see README).
  "observability": { "enabled": true }
}
